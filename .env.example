# Copy to .env and fill in. Never commit .env.

MODE=backtest                      # backtest | paper | live
I_UNDERSTAND_LIVE_TRADING=no       # live mode needs MODE=live AND this set to yes

# CoinDCX API key: trade + read ONLY, never withdrawal. Bind to the server IP.
COINDCX_API_KEY=your-key-here
COINDCX_API_SECRET=your-secret-here

# Telegram (Phase 3)
TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_CHAT_ID=000000000
